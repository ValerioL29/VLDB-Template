<?xml version="1.0" encoding="utf-8"?>
<!-- Numeric ACM references, following the output of ACM-Reference-Format.bst
     (acmart v2.19) for the entry types in ../latex/sample.bib. -->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-US" demote-non-dropping-particle="sort-only">
  <info>
    <title>ACM Reference Format (PVLDB template)</title>
    <id>pvldb-acm-reference-format</id>
    <updated>2026-11-17T00:00:00+00:00</updated>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="month-01" form="short">Jan.</term>
      <term name="month-02" form="short">Feb.</term>
      <term name="month-03" form="short">March</term>
      <term name="month-04" form="short">April</term>
      <term name="month-05" form="short">May</term>
      <term name="month-06" form="short">June</term>
      <term name="month-07" form="short">July</term>
      <term name="month-08" form="short">Aug.</term>
      <term name="month-09" form="short">Sept.</term>
      <term name="month-10" form="short">Oct.</term>
      <term name="month-11" form="short">Nov.</term>
      <term name="month-12" form="short">Dec.</term>
    </terms>
  </locale>
  <macro name="names">
    <names variable="author">
      <name and="text" delimiter=", " delimiter-precedes-last="contextual"/>
      <substitute>
        <names variable="editor">
          <name and="text" delimiter=", " delimiter-precedes-last="contextual"/>
          <label form="short" text-case="capitalize-first" prefix=" (" suffix=")"/>
        </names>
      </substitute>
    </names>
  </macro>
  <macro name="sort-names">
    <names variable="author">
      <name name-as-sort-order="all"/>
      <substitute>
        <names variable="editor"/>
      </substitute>
    </names>
  </macro>
  <macro name="editors">
    <names variable="editor">
      <name and="text" delimiter=", " delimiter-precedes-last="contextual"/>
      <label form="short" text-case="capitalize-first" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="edition">
    <text variable="edition" prefix="(" suffix=" ed.)"/>
  </macro>
  <!-- "Series, Vol. N." Books print the series only with a volume. -->
  <macro name="series">
    <choose>
      <if variable="volume">
        <group delimiter=", " suffix=". ">
          <text variable="collection-title"/>
          <text variable="volume" prefix="Vol. "/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="publisher">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>
  <macro name="month-year">
    <date variable="issued">
      <date-part name="month" form="short" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="tail">
    <text variable="DOI" prefix=" doi:"/>
    <text variable="note" prefix=" " suffix="."/>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <group delimiter=", ">
        <text variable="citation-number"/>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="0">
    <sort>
      <key macro="sort-names"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout>
      <text variable="citation-number" prefix="[" suffix="]"/>
      <text macro="names" suffix=". "/>
      <date variable="issued" suffix=". ">
        <date-part name="year"/>
      </date>
      <choose>
        <if type="article-journal article-magazine article-newspaper periodical" match="any">
          <text variable="title" suffix=". "/>
          <group delimiter=", " suffix=".">
            <group delimiter=" ">
              <text variable="container-title" font-style="italic"/>
              <group delimiter=", ">
                <text variable="volume"/>
                <text variable="issue"/>
              </group>
              <text macro="month-year" prefix="(" suffix=")"/>
            </group>
            <text variable="page"/>
          </group>
          <text macro="tail"/>
        </if>
        <else-if type="paper-conference">
          <text variable="title" suffix=". "/>
          <group delimiter=", " suffix=". ">
            <group delimiter=" ">
              <text term="in" text-case="capitalize-first"/>
              <group delimiter=" " font-style="italic">
                <text variable="container-title"/>
                <group delimiter=", " prefix="(" suffix=")">
                  <text variable="collection-title"/>
                  <text variable="volume" prefix="Vol. "/>
                </group>
              </group>
            </group>
            <text macro="editors"/>
          </group>
          <group delimiter=", " suffix=".">
            <text macro="publisher"/>
            <text variable="page"/>
          </group>
          <text macro="tail"/>
        </else-if>
        <else-if type="chapter" variable="container-title" match="all">
          <!-- incollection -->
          <text variable="title" suffix=". "/>
          <group delimiter=", " suffix=". ">
            <group delimiter=" ">
              <text term="in" text-case="capitalize-first"/>
              <text variable="container-title" font-style="italic"/>
              <text macro="edition"/>
            </group>
            <text macro="editors"/>
          </group>
          <text macro="series"/>
          <group delimiter=", " suffix=".">
            <text macro="publisher"/>
            <text variable="page"/>
          </group>
          <text macro="tail"/>
        </else-if>
        <else-if type="chapter book" match="any">
          <!-- inbook, book -->
          <group delimiter=" " suffix=". ">
            <text variable="title" font-style="italic"/>
            <text macro="edition"/>
          </group>
          <text macro="series"/>
          <group delimiter=", " suffix=".">
            <text macro="publisher"/>
            <choose>
              <if type="chapter">
                <text variable="chapter-number" prefix="Chapter "/>
              </if>
            </choose>
            <text variable="page"/>
          </group>
          <text macro="tail"/>
        </else-if>
        <else-if type="report thesis" match="any">
          <text variable="title" font-style="italic" suffix=". "/>
          <group delimiter=" " suffix=". ">
            <text variable="genre"/>
            <text variable="number"/>
          </group>
          <group delimiter=", " suffix=".">
            <text variable="authority"/>
            <text variable="publisher-place"/>
          </group>
          <text macro="tail"/>
        </else-if>
        <else>
          <!-- online -->
          <text variable="title" font-style="italic" suffix=". "/>
          <text variable="authority" suffix=". "/>
          <group delimiter=" ">
            <text value="Retrieved"/>
            <date variable="accessed" form="text"/>
            <text value="from"/>
            <text variable="URL"/>
          </group>
          <text macro="tail"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
